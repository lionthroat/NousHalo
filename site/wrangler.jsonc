// The download page at https://noushalo.lionthroat.com: static files behind a tiny Worker
// (src/worker.js) that sends http visits to https.
// Deploy from this folder:  npx wrangler@4 deploy
// Preview locally:          npx wrangler@4 dev
{
  "name": "noushalo-site",
  "compatibility_date": "2026-09-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // the Worker sees every request first, so http ones can be redirected
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "noushalo.lionthroat.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
